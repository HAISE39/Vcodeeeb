<!DOCTYPE html>
<html>
<head>
    <title>Edit Script - Secure Script Delivery</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-white">
    <div class="container mt-5 mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Edit Script: <%= script.name %></h2>
            <a href="/dashboard" class="btn btn-secondary">Back</a>
        </div>

        <div class="row">
            <div class="col-md-8">
                <div class="card bg-secondary mb-4">
                    <div class="card-header">Script Content</div>
                    <div class="card-body">
                        <form action="/dashboard/edit/<%= script.id %>" method="POST">
                            <div class="mb-3">
                                <label>Name</label>
                                <input type="text" name="name" value="<%= script.name %>" class="form-control" required>
                            </div>
                            <div class="mb-3">
                                <label>Description</label>
                                <textarea name="description" class="form-control" rows="2"><%= script.description %></textarea>
                            </div>
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" name="isActive" <%= script.isActive ? 'checked' : '' %>>
                                <label class="form-check-label">Active</label>
                            </div>
                            <div class="mb-3">
                                <label>Lua Code</label>
                                <textarea name="content" class="form-control font-monospace" rows="15" required><%= content %></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary">Update Script</button>
                        </form>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card bg-dark border-light">
                    <div class="card-header border-light">Game Guardian Loader</div>
                    <div class="card-body">
                        <p class="small text-muted">Copy this script to your Game Guardian.</p>
                        <textarea class="form-control bg-black text-success font-monospace" rows="15" readonly><%= loaderCode %></textarea>
                        <button class="btn btn-outline-light mt-2 w-100" onclick="navigator.clipboard.writeText(this.previousElementSibling.value)">Copy Loader</button>
                    </div>
                </div>

                <div class="card bg-dark border-light mt-3">
                    <div class="card-header border-light">Script Info</div>
                    <div class="card-body">
                        <p><strong>UUID:</strong> <%= script.uuid %></p>
                        <p><strong>Secret Key:</strong> <%= script.secretKey %></p>
                        <p><strong>Raw URL:</strong> <a href="/raw/<%= script.uuid %>" target="_blank" class="text-info">/raw/<%= script.uuid %></a></p>
                        <div class="alert alert-warning small">
                            Directly visiting the Raw URL in a browser will redirect you away or show an error.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
