<!DOCTYPE html>
<html>
<head>
    <title>Dashboard - Secure Script Delivery</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-white">
    <nav class="navbar navbar-dark bg-secondary mb-4">
        <div class="container">
            <a class="navbar-brand" href="#">SecureScript</a>
            <div class="d-flex">
                <span class="navbar-text me-3"><%= user.email %> (<%= user.role %>)</span>
                <a href="/auth/logout" class="btn btn-outline-light btn-sm">Logout</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Your Scripts</h2>
            <a href="/dashboard/create" class="btn btn-primary">Create New Script</a>
        </div>

        <div class="table-responsive">
            <table class="table table-dark table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Created By</th>
                        <th>Created At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% scripts.forEach(script => { %>
                        <tr>
                            <td><%= script.name %></td>
                            <td>
                                <span class="badge bg-<%= script.isActive ? 'success' : 'danger' %>">
                                    <%= script.isActive ? 'Active' : 'Disabled' %>
                                </span>
                            </td>
                            <td><%= script.User.email %></td>
                            <td><%= new Date(script.createdAt).toLocaleDateString() %></td>
                            <td>
                                <a href="/dashboard/edit/<%= script.id %>" class="btn btn-sm btn-info">Manage</a>
                                <form action="/dashboard/delete/<%= script.id %>" method="POST" class="d-inline" onsubmit="return confirm('Are you sure?');">
                                    <button class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                    <% if (scripts.length === 0) { %>
                        <tr><td colspan="5" class="text-center">No scripts found.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
