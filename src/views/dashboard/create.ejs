<!DOCTYPE html>
<html>
<head>
    <title>Create Script - Secure Script Delivery</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-white">
    <div class="container mt-5">
        <h2>Create New Script</h2>
        <form action="/dashboard/create" method="POST">
            <div class="mb-3">
                <label>Script Name</label>
                <input type="text" name="name" class="form-control" required>
            </div>
            <div class="mb-3">
                <label>Description</label>
                <textarea name="description" class="form-control" rows="2"></textarea>
            </div>
            <div class="mb-3">
                <label>Lua Script Content</label>
                <textarea name="content" class="form-control font-monospace" rows="15" required placeholder="print('Hello World')"></textarea>
            </div>
            <button type="submit" class="btn btn-success">Save Script</button>
            <a href="/dashboard" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</body>
</html>
